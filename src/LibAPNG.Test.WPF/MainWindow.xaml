<Window
    x:Class="LibAPNG.Test.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="APNG.NET Demo"
    Width="800"
    Height="600"
    MinWidth="500"
    MinHeight="400"
    Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border
            Grid.Row="0"
            Padding="8,6"
            Background="#2D2D30">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="BtnOpen"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Background="#0E639C"
                    BorderThickness="0"
                    Click="BtnOpen_Click"
                    Content="Open APNG..."
                    Cursor="Hand"
                    Foreground="White" />
                <Separator
                    Width="1"
                    Margin="4,0"
                    Background="#555" />
                <Button
                    x:Name="BtnPlay"
                    Margin="8,0,4,0"
                    Padding="10,6"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    Click="BtnPlay_Click"
                    Content="▶ Play"
                    Cursor="Hand"
                    Foreground="White"
                    IsEnabled="False" />
                <Button
                    x:Name="BtnPause"
                    Margin="0,0,4,0"
                    Padding="10,6"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    Click="BtnPause_Click"
                    Content="⏸ Pause"
                    Cursor="Hand"
                    Foreground="White"
                    IsEnabled="False" />
                <Button
                    x:Name="BtnStop"
                    Margin="0,0,4,0"
                    Padding="10,6"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    Click="BtnStop_Click"
                    Content="⏹ Stop"
                    Cursor="Hand"
                    Foreground="White"
                    IsEnabled="False" />
                <Separator
                    Width="1"
                    Margin="8,0"
                    Background="#555" />
                <TextBlock
                    x:Name="TxtInfo"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#AAAAAA"
                    Text="File not loaded ..." />
            </StackPanel>
        </Border>

        <!--  Image display area  -->
        <Border
            Grid.Row="1"
            Margin="8"
            Background="#252526"
            BorderBrush="#3C3C3C"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <!--  Checkerboard background for transparency visualization  -->
                <Rectangle x:Name="CheckerBg" Visibility="Collapsed">
                    <Rectangle.Fill>
                        <DrawingBrush
                            TileMode="Tile"
                            Viewport="0,0,20,20"
                            ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#CCCCCC">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#999999">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,10,10" />
                                                <RectangleGeometry Rect="10,10,10,10" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Image
                    x:Name="ImgDisplay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="Uniform" />

                <TextBlock
                    x:Name="TxtPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#555"
                    Text="拖放 APNG 文件到此处，或点击「打开 APNG…」按钮"
                    TextAlignment="Center" />
            </Grid>
        </Border>

        <!--  Frame progress bar  -->
        <Border
            x:Name="ProgressBar"
            Grid.Row="2"
            Padding="8,4"
            Background="#2D2D30"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TxtFrameLabel"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="#AAAAAA"
                    Text="帧 0/0" />
                <Slider
                    x:Name="FrameSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Minimum="0"
                    TickFrequency="1"
                    ValueChanged="FrameSlider_ValueChanged" />
                <TextBlock
                    x:Name="TxtFrameTime"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#AAAAAA"
                    Text="0ms" />
            </Grid>
        </Border>

        <!--  Status bar  -->
        <Border
            Grid.Row="3"
            Padding="8,3"
            Background="#007ACC">
            <TextBlock
                x:Name="TxtStatus"
                FontSize="11"
                Foreground="White"
                Text="Ready" />
        </Border>
    </Grid>
</Window>
