<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net35;net40;net45;net451;net452;net46;net462;net47;net471;net472;net48;net481;netstandard2.0;netstandard2.1;.netcoreapp2.0;netcoreapp2.1;netcoreapp2.2;netcoreapp3.0;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <NoWarn>${NoWarn};NU1902;NU1903</NoWarn>
        <PackageId>QuickLook.LibAPNG</PackageId>
        <Product>LibAPNG</Product>
        <AssemblyName>LibAPNG</AssemblyName>
        <RootNamespace>LibAPNG</RootNamespace>
        <Nullable>disable</Nullable>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <AssemblyVersion>0.3.0.0</AssemblyVersion>
        <FileVersion>0.3.0.0</FileVersion>
        <Version>$(VersionPrefix)0.3.0.0</Version>
        <Authors>QL-Win</Authors>
        <Company>QL-Win</Company>
        <Description>A fully-managed APNG Parser.</Description>
        <PackageProjectUrl>https://github.com/QL-Win/QuickLook.LibAPNG</PackageProjectUrl>
        <RepositoryUrl>https://github.com/QL-Win/QuickLook.LibAPNG</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>.NET APNG Parser</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Logo.png</PackageIcon>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
        <None Include="..\..\Logo.png" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
